From Ltac2 Require Import Printf.
From BinReader Require Import BinReader.
From Cert Require Import LowLevelChecker CertificateSchema.

Section Benchmark.

Definition decode cert := Packed.decode certificate_wire_schema cert.

Definition decode_and_apply f cert :=
  match decode cert with
  | Some cert => f (build_cert cert)
  | None => false
  end.

Ltac2 Eval printf "certificate loading:".
Time LoadDataPacked "@CERT@" As cert.

Ltac2 Eval printf "certificate decoding:".
Time Eval vm_compute in match decode cert with Some _ => true | None => false end.

Ltac2 Eval printf "vertex containment:".
Time Eval vm_compute in decode_and_apply VtxContainment.check_certificate cert.

Ltac2 Eval printf "vertex equality:".
Time Eval vm_compute in decode_and_apply VtxEquality.check_certificate cert.

Ltac2 Eval printf "graph equality:".
Time Eval vm_compute in decode_and_apply GraphEquality.check_certificate cert.

End Benchmark.
